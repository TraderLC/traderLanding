# ==============================================================================
# TraderLC Landing Page Environment Configuration
# ==============================================================================

# Server & Network Ports (External: 7100, Internal: 7000)
PORT=7100
INTERNAL_PORT=7000
HOSTNAME=0.0.0.0
NODE_ENV=production

# Container Restart Policy
RESTART_POLICY=always

# Memory Limits (Keeps container strictly within 512MB RAM)
MEM_LIMIT=512M
MEM_RESERVATION=128M
NODE_OPTIONS=--max-old-space-size=384

# Public Domain & API URLs (evaluated at build time)
NEXT_PUBLIC_SITE_URL=https://traderlc.com
NEXT_PUBLIC_API_URL=https://traderlc.com/api

# Shared Backend Docker Network Name
TRADERLC_NETWORK=traderlc_network
